#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
        };

        settingsmenu {
            bindings = <&mo 5>;
            key-positions = <36 37 38>;
        };

        left_win {
            bindings = <&kp LEFT_WIN>;
            key-positions = <40 39>;
        };

        ctrl_alt_del {
            bindings = <&kp LC(LA(DELETE))>;
            key-positions = <37 29 38 36>;
        };

        mouse_jump {
            bindings = <&kp LG(LS(D))>;
            key-positions = <0 12 24>;
        };

        clear_all_bluetooth {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <0 1 2 3 4 5 36 37 38>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESC         &kp Q             &kp W  &kp F               &kp P             &kp G          &kp J      &kp L                        &kp U      &kp Y    &kp APOS              &trans
&kp TAB         &kp A             &kp R  &kp S               &kp T             &kp D          &kp H      &kp N                        &kp E      &kp I    &kp O                 &none
&kp LEFT_SHIFT  &mt LEFT_SHIFT Z  &kp X  &kp C               &kp V             &kp B          &kp K      &kp M                        &kp COMMA  &kp DOT  &mt RIGHT_SHIFT FSLH  &none
                                         &mt LEFT_ALT TILDE  &mt LCTRL DELETE  &lt 1 SPACE    &lt 2 RET  &mt LC(BACKSPACE) BACKSPACE  &none
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp LC(NUMBER_1)  &kp N1               &kp N2          &kp N3          &kp N4           &kp N5           &kp N6             &kp N7  &kp N8  &kp N9  &kp N0      &none
&kp LC(NUMBER_2)  &kp TAB              &kp LEFT_ARROW  &kp UP          &kp RIGHT_ARROW  &kp LG(LS(S))    &kp C_VOLUME_UP    &kp N4  &kp N5  &kp N6  &kp SEMI    &trans
&kp LC(NUMBER_3)  &mt LEFT_SHIFT CAPS  &trans          &kp DOWN_ARROW  &kp C_PREVIOUS   &kt C_NEXT       &kp C_VOLUME_DOWN  &kp N1  &kp N2  &kp N3  &kp PERIOD  &trans
                                                       &trans          &trans           &trans           &kp RET            &kp N0  &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp F1   &kp F2    &kp F3         &kp F4   &kp F5    &kp F6     &kp F7     &kp F8            &kp F9             &kp F10        &kp F11
&trans  &kp TAB  &kp HOME  &kp PG_UP      &kp END  &trans    &kp PLUS   &kp MINUS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans         &kp F12
&trans  &trans   &trans    &kp PAGE_DOWN  &trans   &trans    &kp EQUAL  &kp UNDER  &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp BACKSLASH  &kp SLASH
                           &trans         &trans   &trans    &trans     &trans     &trans
            >;
        };

        Gaming {
            bindings = <
&kp ESCAPE  &kp TAB           &kp Q  &kp W         &kp E    &kp R        &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp LEFT_SHIFT    &kp A  &kp S         &kp D    &kp F        &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp LEFT_CONTROL  &kp Z  &kp X         &kp C    &kp V        &trans  &trans  &trans  &trans  &trans  &trans
                                     &kp LEFT_ALT  &lt 4 M  &kp SPACE    &trans  &trans  &trans
            >;
        };

        gamingmod {
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                    &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };

        Settings {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&tog 3      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };
    };
};
